# ------------------------------------------------------------------
# MentoClock production template.
# Copy to .env on the SERVER and fill in the real values.
# Never upload your local .env - create a fresh one on the server.
# ------------------------------------------------------------------

APP_NAME=MentoClock
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

# --- Database (MySQL 8 / MariaDB with InnoDB) ---
# Create an EMPTY database + user on the host first, then fill in here.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Sessions / cache (file drivers suit single-server shared hosting) ---
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- CORS: comma-separated app origins, e.g. https://app.example.com ---
# Keep "*" only for testing; lock this down in production.
CORS_ALLOWED_ORIGINS=*

# --- Set TRUSTED_PROXIES=* if the host runs behind a proxy/CDN ---
# (cPanel, Cloudflare, Nginx reverse proxy). Leave empty for local dev.
TRUSTED_PROXIES=

LOG_CHANNEL=stack

# --- First admin account (used by php artisan db:seed, works everywhere) ---
# MENTO_SETUP_EMAIL=admin@example.com
# MENTO_SETUP_PASSWORD=choose-a-password-12-plus-chars
