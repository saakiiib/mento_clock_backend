APP_NAME=MentoClock
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mento_clock
DB_USERNAME=mento_clock
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack

MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@your-domain.example
MAIL_FROM_NAME="MentoClock"

# V36: start false so employees already working can clock out normally.
# After testing strict clock-outs at each workplace, set true.
ATTENDANCE_GPS_STRICT_CLOCK_OUT=false

# Mobile app release check (GET /api/app/version). Raise the build number
# after publishing a new store release; UPDATE_REQUIRED blocks older builds.
ANDROID_APP_VERSION=1.0.0
ANDROID_APP_BUILD=0
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.mentosoftware.mento_clock
IOS_APP_VERSION=1.0.0
IOS_APP_BUILD=0
IOS_APP_STORE_URL=
UPDATE_REQUIRED=false
UPDATE_REMIND_LATER_HOURS=24
APP_UPDATE_MESSAGE="A new version of MentoClock is available. Please update to continue enjoying the latest features and improvements."
